# Adstack reads these from the environment; it does not load this file.
# Put them in your shell or secret manager, and never commit real values.

# The Google Ads account (or set provider.google_ads.customer_id in the configuration):
GOOGLE_ADS_CUSTOMER_ID=123-456-7890
# Only when you access the account through a manager account:
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=111-222-3333

# OAuth credentials with the https://www.googleapis.com/auth/adwords scope:
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# ...or a short-lived access token instead of the three values above:
# GOOGLE_ADS_ACCESS_TOKEN=

# Optional:
# ADSTACK_SANDBOX=1             # use the local sandbox account by default
# ADSTACK_MCP_ALLOW_APPLY=1     # let `adstack mcp` apply approved plans to the real account
